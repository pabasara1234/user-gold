{
  "rules": {
    "users": {
      ".read": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12')",
        ".write": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || (auth.uid === $uid && !data.exists() && newData.child('uid').val() === $uid && newData.child('status').val() === 'pending'))",
        "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
        "fullName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "nic": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 15" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'denied' || newData.val() === 'disabled'" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "reviewedAt": { ".validate": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' && newData.isNumber()" },
        "reviewedBy": { ".validate": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' && newData.isString()" },
        "pushSubscriptions": {
          "$subscriptionSlot": {
            ".write": "auth != null && $subscriptionSlot.matches(/^slot_[0-9]$/) && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || (auth.uid === $uid && root.child('users').child($uid).child('status').val() === 'approved'))",
            ".validate": "newData.hasChildren(['endpoint', 'keys'])",
            "endpoint": {
              ".validate": "newData.isString() && newData.val().length <= 4096 && newData.val().matches(/^https:\\/\\//)"
            },
            "keys": {
              ".validate": "newData.hasChildren(['p256dh', 'auth'])",
              "p256dh": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512" },
              "auth": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 256" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": {
          ".validate": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || ($other === 'pushSubscriptions' && auth.uid === $uid && root.child('users').child($uid).child('status').val() === 'approved'))"
        }
      }
    },
    "signals": {
      "$symbol": {
        ".read": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || root.child('users').child(auth.uid).child('status').val() === 'approved')",
        ".write": false
      }
    },
    "market": {
      "$symbol": {
        ".read": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || root.child('users').child(auth.uid).child('status').val() === 'approved')",
        ".write": false
      }
    },
    "relayControl": {
      "active": {
        ".read": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'",
        ".write": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'",
        ".validate": "newData.hasChildren(['enabled', 'symbol', 'requestedAt'])",
        "enabled": { ".validate": "newData.isBoolean()" },
        "symbol": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9._-]{2,20}$/)" },
        "requestedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "relayStatus": {
      "active": {
        ".read": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'",
        ".write": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'",
        ".validate": "newData.hasChildren(['running', 'updatedAt', 'signalCount'])",
        "running": { ".validate": "newData.isBoolean()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "signalCount": { ".validate": "newData.isNumber()" },
        "lastError": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}