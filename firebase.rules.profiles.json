{
  "rules": {
    "users": {
      ".read": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12')",
        ".write": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || (auth.uid === $uid && !data.exists() && newData.child('uid').val() === $uid && newData.child('status').val() === 'pending'))",
        "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
        "fullName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "nic": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 15" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'denied' || newData.val() === 'disabled'" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "reviewedAt": { ".validate": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' && newData.isNumber()" },
        "reviewedBy": { ".validate": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' && newData.isString()" },
        "$other": { ".validate": "auth != null && auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12'" }
      }
    },
    "signals": {
      "$symbol": {
        ".read": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || root.child('users').child(auth.uid).child('status').val() === 'approved')",
        ".write": false
      }
    },
    "market": {
      "$symbol": {
        ".read": "auth != null && (auth.uid === 'LmimXySoBHbywGG91I4ozMECPy12' || root.child('users').child(auth.uid).child('status').val() === 'approved')",
        ".write": false
      }
    }
  }
}