FIREBASE_PROJECT_ID=website-sign-in-dbc96
FIREBASE_PROFILES_DATABASE_URL=https://website-sign-in-dbc96-default-rtdb.firebaseio.com
FIREBASE_ADMIN_UIDS=LmimXySoBHbywGG91I4ozMECPy12
MYVIEW_REQUIRE_AUTH=true
# Allows the desktop Market Lab to access the API only from this computer.
MYVIEW_ALLOW_LOCAL_ACCESS=true
MYVIEW_CORS_ORIGINS=https://signals.example.com
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\website-sign-in-service-account.json
# Use the mail provider's SMTP app password, not a normal account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-mail-account-app-password
SMTP_FROM_EMAIL=notifications@example.com
SMTP_USE_SSL=false
# Keep the private key outside the repository; only its public key goes in Vite/GitHub.
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=C:\secure\myview-vapid-private.pem
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.com