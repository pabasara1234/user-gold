{
  "name": "myview",
  "productName": "MyView Market Lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop\\main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-api.ps1",
    "build:desktop": "npm run build && npm run build:api && electron-builder --win nsis --x64",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "35.7.5",
    "electron-builder": "25.1.8",
    "oxlint": "^1.88.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.myview.marketlab",
    "productName": "MyView Market Lab",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/MyViewApi",
        "to": "backend"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MyView-Market-Lab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyView Market Lab",
      "uninstallDisplayName": "MyView Market Lab"
    }
  }
}
